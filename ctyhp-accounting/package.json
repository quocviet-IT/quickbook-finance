{
  "name": "ctyhp-accounting",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "security:check-source": "node scripts/check-source-credentials.mjs",
    "security:verify-deployment": "node --env-file=.env.local scripts/verify-production-security-readonly.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "quality:bundle": "node scripts/quality/run-bundle.mjs",
    "quality:runtime": "node --env-file-if-exists=.env.local scripts/quality/run-runtime.mjs",
    "quality:budget": "node scripts/quality/run-budget.mjs",
    "quality:report": "node scripts/quality/report.mjs",
    "quality:all": "npm run quality:bundle && npm run quality:runtime",
    "quality:accept-baseline": "node scripts/quality/accept-baseline.mjs",
    "verify:void-payment": "node --env-file=.env.local scripts/verify-void-payment.mjs",
    "verify:delete-payment": "node --env-file=.env.local scripts/verify-delete-payment.mjs",
    "verify:payment-correction": "node --env-file=.env.local scripts/verify-payment-correction.mjs",
    "verify:company-provisioning": "node --env-file=.env.local scripts/verify-company-provisioning.mjs",
    "verify:bank-categories": "node --env-file=.env.local scripts/verify-bank-categories.mjs",
    "verify:import-transactions": "node --env-file=.env.local scripts/verify-import-transactions.mjs",
    "verify:saved-reports": "node --env-file=.env.local scripts/verify-saved-reports.mjs",
    "verify:saved-report-bucket": "node --env-file=.env.local scripts/verify-saved-report-bucket.mjs",
    "verify:financial-analysis": "node --env-file=.env.local scripts/verify-financial-analysis.mjs",
    "verify:work-item-state": "node --env-file=.env.local scripts/verify-work-item-state.mjs",
    "verify:work-policy": "node --env-file=.env.local scripts/verify-work-policy.mjs",
    "verify:close-readiness": "node --env-file=.env.local scripts/verify-close-readiness.mjs",
    "verify:monthly-ledger": "node --env-file=.env.local scripts/verify-monthly-ledger.mjs",
    "verify:ledger-import": "node --env-file=.env.local scripts/verify-ledger-import.mjs",
    "verify:column-resize": "node --env-file=.env.local scripts/verify-column-resize.mjs",
    "verify:theme": "node --env-file=.env.local scripts/verify-theme.mjs",
    "verify:transaction-filters": "node --env-file=.env.local scripts/verify-transaction-filters.mjs",
    "guide:shots": "node --env-file=.env.local scripts/capture-guide-shots.mjs",
    "verify:feedback-access": "node --env-file=.env.local scripts/verify-feedback-access.mjs",
    "verify:feedback-files": "node --env-file=.env.local scripts/verify-feedback-files.mjs",
    "verify:settings-guard": "node --env-file=.env.local scripts/verify-settings-guard.mjs",
    "smoke:payments-void": "node --env-file=.env.local scripts/smoke-payments-void.mjs",
    "test:e2e:document-ledger-report": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts",
    "test:watch": "vitest",
    "verify:document-files": "node --env-file=.env.local scripts/verify-document-files-every-company.mjs",
    "test:e2e:document-scan": "node --env-file=.env.local ./node_modules/vitest/vitest.mjs run --config vitest.e2e.config.ts tests/e2e/document-scan.e2e.ts",
    "test:scanner-gateway": "node ../services/document-scanner/test/contract.test.mjs",
    "verify:entitlement": "node --env-file=.env.local scripts/verify-entitlement.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.5",
    "antd": "^6.5.1",
    "dayjs": "^1.11.21",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "modern-screenshot": "^4.7.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "js-yaml": "^4.3.1",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
