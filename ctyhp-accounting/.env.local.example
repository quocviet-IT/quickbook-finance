# Supabase project: ctyhp-accounting
# Copy to .env.local and fill in from the Supabase dashboard (Project Settings > API).

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser, NEVER commit the real value.
# Used only for administrative/seed scripts, not in request handlers.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# End-to-end test sign-in. Optional: falls back to SMOKE_EMAIL / SMOKE_PASSWORD,
# then to the demo administrator that scripts/smoke-pages.mjs uses.
E2E_EMAIL=admin@ctyhp.vn
E2E_PASSWORD=

# Direct bank feeds (server-only). Start with PLAID_ENV=sandbox.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox
PLAID_CLIENT_NAME=CTYHP Accounting
# Generate a unique value of at least 32 characters; rotating it requires
# re-encrypting every stored provider token.
BANK_FEED_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Used by Vercel Cron to authorize the daily background sync route.
CRON_SECRET=replace-with-another-long-random-secret
# Optional for OAuth institutions.
PLAID_REDIRECT_URI=https://your-domain.example.com/banking

# Private malware-scanner gateway (server-only). The endpoint receives the raw
# file body with Authorization: Bearer <token> and returns:
# {"verdict":"clean"|"blocked","engine":"...","threat":"..."}
DOCUMENT_SCANNER_URL=https://scanner.internal.example.com/v1/scan
DOCUMENT_SCANNER_TOKEN=replace-with-a-long-random-scanner-token

# In-app AI assistant (server-only). Any provider with an OpenAI-compatible
# /chat/completions endpoint works; set AI_AUTH_HEADER=x-api-key if the provider
# expects the key in that header instead of Authorization: Bearer.
AI_BASE_URL=https://api.your-provider.example.com/v1
AI_MODEL=your-model-id
AI_API_KEY=replace-with-the-provider-key
# AI_AUTH_HEADER=x-api-key
